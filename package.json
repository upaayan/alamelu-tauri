{
  "name": "alamelu-pi-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Alamelu Pi desktop shell over the installed pi command.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm --filter @alamelu-pi/desktop run build",
    "typecheck": "pnpm --filter @alamelu-pi/desktop run typecheck",
    "package:alpi:dir": "pnpm --filter @alamelu-pi/desktop run package:alpi:dir",
    "verify:external-runtime": "pnpm --filter @alamelu-pi/desktop run verify:external-runtime",
    "verify:packaged-runtime-deps": "pnpm --filter @alamelu-pi/desktop run verify:packaged-runtime-deps"
  }
}
